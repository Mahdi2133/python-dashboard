# Copy to .env and adjust. python-dotenv loads this automatically.

# Secret key for sessions/CSRF — set a long random value in production.
SECRET_KEY=change-me-to-a-long-random-string

# Database.
#  - Development (this machine, zero-install): leave unset to use SQLite under instance/.
#  - Production (host PC): point to PostgreSQL/PostGIS, e.g.
# DATABASE_URL=postgresql+psycopg2://water_user:password@localhost:5432/water_supply

# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
